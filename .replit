entrypoint = "server.py"
modules = ["python-3.11"]
run = "python3 server.py --host 0.0.0.0 --port 3000"
hidden = [".git", "__pycache__", "data", "private-validation", "workspace-backups"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["python3", "server.py", "--host", "0.0.0.0", "--port", "3000"]

[[ports]]
internalPort = 3000
externalPort = 80
