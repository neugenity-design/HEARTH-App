entrypoint = "server.py"
modules = ["python-3.12", "nodejs-20", "web", "nix"]
run = "python3 server.py --host 0.0.0.0 --port 3000"
hidden = [".git", "__pycache__", "data", "private-validation", "workspace-backups"]

[gitHubImport]
requiredFiles = [".replit", "replit.nix"]

[deployment]
run = ["python3", "server.py", "--host", "0.0.0.0", "--port", "3000"]

[[ports]]
localPort = 3000
externalPort = 80

[[ports]]
localPort = 5000
externalPort = 5000

[nix]
channel = "stable-25_05"

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "Run Hearth"

[[workflows.workflow]]
name = "Run Hearth"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "python3 server.py --host 0.0.0.0 --port 5000"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"
