# Required whenever Hearth listens beyond localhost.
HEARTH_USERNAME=owner
HEARTH_PASSWORD=replace-with-a-long-random-password

# Replit supplies PORT automatically. Use this locally only when needed.
PORT=3000

# Optional until Google Workspace email is configured online.
# HEARTH_BASE_URL=https://your-hearth-name.replit.app

# Development data path. Published data needs Replit Database and App Storage migration.
HEARTH_DATA_DIR=data
